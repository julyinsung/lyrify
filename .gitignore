# Dependencies
node_modules/
package-lock.json

# Environment Variables & Secrets (SEC-001)
.env
.env.local
.env.*.local
*.pem
*.key

# Application runtime data & cache
data/*.json
!data/.gitkeep
dist/
build/
.cache/

# Logs & Evidence
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tests/logs/*.log
!tests/logs/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/
__pycache__/
docs/runs/_exec/
